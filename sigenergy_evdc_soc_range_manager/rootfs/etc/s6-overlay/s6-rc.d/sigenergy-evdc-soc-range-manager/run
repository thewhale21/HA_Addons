#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: SigEnergy EVDC SoC Range Manager
# Runs the add-on (src/__main__.py). Its options are read from
# /data/options.json by src/config.py, so there's nothing to export here.
# ==============================================================================

bashio::log.info "Starting SigEnergy EVDC SoC Range Manager..."
cd /app || exit 1
exec python3 -m src
